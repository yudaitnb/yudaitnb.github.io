{%- comment -%}
  Type and topic tags of a publication, shown under its abbr badge in the
  left column of _layouts/bib.liquid (the site's override of al_folio_core's
  layout includes this file). Each tag links to the publications page
  filtered by it; the filter tokens themselves are written by
  _includes/hook/bib.liquid (see _data/publication_filters.yml).
  Long tags wrap inside the narrow column instead of overflowing it.
{%- endcomment -%}
{%- assign pt_url = '/publications/' | relative_url -%}
{%- assign pt_style = 'display:inline-block;max-width:100%;margin:.3rem .1rem 0;padding:0 .35rem;border:1px solid var(--global-divider-color);border-radius:.25rem;font-size:.7rem;line-height:1.35;white-space:normal;overflow-wrap:anywhere;color:var(--global-text-color-light);text-decoration:none;' -%}
{%- capture pt_tags -%}
  {%- if entry.kind -%}
    {%- assign pt_label = entry.kind | strip -%}
    <a href="{{ pt_url }}#{{ pt_label | slugify | prepend: 'type-' }}" style="{{ pt_style }}">{{ pt_label }}</a>{{ ' ' }}
  {%- endif -%}
  {%- if entry.topics -%}
    {%- assign pt_topics = entry.topics | split: ',' -%}
    {%- for pt_topic in pt_topics -%}
      {%- assign pt_label = pt_topic | strip -%}
      {%- if pt_label != '' -%}
        <a href="{{ pt_url }}#{{ pt_label | slugify | prepend: 'topic-' }}" style="{{ pt_style }}">{{ pt_label }}</a>{{ ' ' }}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if pt_tags != '' -%}
  <div class="publication-tags" style="text-align:center;">{{ pt_tags }}</div>
{%- endif -%}
