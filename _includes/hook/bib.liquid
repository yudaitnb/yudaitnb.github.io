{%- comment -%}
  al_folio_core's bib.liquid includes this hook for every entry, right after it
  builds the venue text (`entrytype`), with `entry` in scope (docs/CUSTOMIZE.md).

  1. `additional_info` goes through markdownify, which leaves a trailing
     newline; the page then shows a space before the ", <month> <year>" that
     follows ("... (ERA) Track , Dec 2026"). Strip it.

  2. Publication filters (see _data/publication_filters.yml). The filter
     buttons on the publications page link to /publications/#<token>, which
     the official search box (bib_search) applies. This hook writes each
     entry's tokens into the entry as visually hidden text, and shows the
     entry's type (`kind`) and `topics` as small tag links after the date:
       type-<kind>    from `kind`   (journal, international conference, ...)
       topic-<topic>  from `topics` (comma-separated)
       role-*         from the author list: first author, co-first author (*),
                      corresponding author (†), editor (@book entries)
       venue-<abbr>   from `abbr`
     To put the tags after the date, the hook appends the month and year
     itself and clears them, so bib.liquid does not add them again.
{%- endcomment -%}
{%- assign entrytype = entrytype | strip -%}

{%- assign pf_url = '/publications/' | relative_url -%}
{%- assign pf_tags = '' -%}
{%- assign pf_tokens = '' -%}
{%- assign pf_tag_style = 'margin-left:.4rem;padding:0 .35rem;border:1px solid var(--global-divider-color);border-radius:.25rem;font-size:.75rem;font-style:normal;white-space:nowrap;color:var(--global-text-color-light);text-decoration:none;' -%}

{%- if entry.kind -%}
  {%- assign pf_label = entry.kind | strip -%}
  {%- assign pf_token = pf_label | slugify | prepend: 'type-' -%}
  {%- capture pf_tags -%}{{ pf_tags }}<a href="{{ pf_url }}#{{ pf_token }}" style="{{ pf_tag_style }}">{{ pf_label }}</a>{%- endcapture -%}
  {%- capture pf_tokens -%}{{ pf_tokens }} {{ pf_token }}{%- endcapture -%}
{%- endif -%}

{%- if entry.topics -%}
  {%- assign pf_topics = entry.topics | split: ',' -%}
  {%- for pf_topic in pf_topics -%}
    {%- assign pf_label = pf_topic | strip -%}
    {%- if pf_label != '' -%}
      {%- assign pf_token = pf_label | slugify | prepend: 'topic-' -%}
      {%- capture pf_tags -%}{{ pf_tags }}<a href="{{ pf_url }}#{{ pf_token }}" style="{{ pf_tag_style }}">{{ pf_label }}</a>{%- endcapture -%}
      {%- capture pf_tokens -%}{{ pf_tokens }} {{ pf_token }}{%- endcapture -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- for pf_author in entry.author_array -%}
  {%- assign pf_last = pf_author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
  {%- if site.scholar.last_name contains pf_last and site.scholar.first_name contains pf_author.first -%}
    {%- if forloop.first -%}
      {%- capture pf_tokens -%}{{ pf_tokens }} role-first-author{%- endcapture -%}
    {%- endif -%}
    {%- if pf_author.last contains '*' -%}
      {%- capture pf_tokens -%}{{ pf_tokens }} role-co-first-author{%- endcapture -%}
    {%- endif -%}
    {%- if pf_author.last contains '†' -%}
      {%- capture pf_tokens -%}{{ pf_tokens }} role-corresponding-author{%- endcapture -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if entry.type == 'book' -%}
  {%- capture pf_tokens -%}{{ pf_tokens }} role-editor{%- endcapture -%}
{%- endif -%}

{%- if entry.abbr and entry.abbr != 'Proceedings' -%}
  {%- capture pf_tokens -%}{{ pf_tokens }} {{ entry.abbr | slugify | prepend: 'venue-' }}{%- endcapture -%}
{%- endif -%}

{%- assign pf_entrytype_text = entrytype | strip_html | strip -%}
{%- capture entrytype -%}
  {{- entrytype -}}
  {%- if pf_entrytype_text != '' and entryyear != '' %}, {% endif -%}
  {{- entrymonth }}{{ entryyear -}}
  {{- pf_tags -}}
  <span aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">{{ pf_tokens }}</span>
{%- endcapture -%}
{%- assign entrymonth = '' -%}
{%- assign entryyear = '' -%}
